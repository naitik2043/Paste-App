# Use the same MongoDB database and database name in LeetMetric and Paste Vault.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate an independent secret for Paste Vault; do not reuse LeetMetric's JWT_SECRET.
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Standalone account verification and password-reset email delivery (Resend).
# Verify your sending domain in Resend before using a production sender address.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Paste Vault <accounts@your-verified-domain.com>
PUBLIC_APP_URL=https://your-paste-vault-domain.example
