# Use the same MongoDB database and database name in LeetMetric and Paste Vault.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate an independent secret for Paste Vault; do not reuse LeetMetric's JWT_SECRET.
# Example generation command: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
